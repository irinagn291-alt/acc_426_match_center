    "Your entries stay on this device and are labelled as local. No result is fetched automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entries stay on this device and are labelled as local. No result is fetched automatically."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus registros ficam neste dispositivo e recebem a identificação local. Nenhum resultado é buscado automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einträge bleiben auf diesem Gerät und werden als lokal gekennzeichnet. Ergebnisse werden nicht automatisch abgerufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos saisies restent sur cet appareil et sont indiquées comme locales. Aucun résultat n'est récupéré automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros se quedan en este dispositivo y se identifican como locales. No se obtienen resultados automáticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci restano sul dispositivo e sono indicate come locali. Nessun risultato viene scaricato automaticamente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ إدخالاتك على الجهاز وتظهر كسجلات محلية. يمكنك تحديث النتيجة بنفسك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄儲存在此裝置並標示為本機比賽。請自行輸入比分。"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entries stay on this device and are labelled as local. No result is fetched automatically."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your entries stay on this device and are labeled as local. No result is fetched automatically."
          }
        }
