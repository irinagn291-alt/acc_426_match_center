    "Your favourites and matchbook stay on your device. Refreshing connects directly to the fixture source or your RSS publisher and shares your IP address with them. No account is required.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your favourites and matchbook stay on your device. Refreshing connects directly to the fixture source or your RSS publisher and shares your IP address with them. No account is required."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus favoritos e registros ficam no dispositivo. Ao atualizar, a fonte de jogos ou RSS recebe seu endereço IP. Não é preciso criar conta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten und Spielbuch bleiben auf dem Gerät. Beim Aktualisieren erhält die Spielplan- oder RSS-Quelle Ihre IP-Adresse. Kein Konto erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos favoris et matchs restent sur l’appareil. Lors de l’actualisation, la source du calendrier ou votre éditeur RSS reçoit votre adresse IP. Aucun compte requis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus favoritos y partidos quedan en el dispositivo. Al actualizar, la fuente del calendario o RSS recibe tu dirección IP. No necesitas una cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferiti e partite restano sul dispositivo. Durante l’aggiornamento la fonte del calendario o RSS riceve l’indirizzo IP. Non serve un account."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ المفضلة والمباريات على جهازك. عند التحديث يتصل التطبيق مباشرة بمصدر المباريات أو ناشر RSS الذي اخترته، ويظهر له عنوان IP الخاص بك. لا يتطلب التطبيق حسابًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏和賽事紀錄儲存在裝置上。重新整理時，裝置會直接連到賽程來源或你選擇的 RSS 出版者，對方會收到 IP 位址。無須建立帳號。"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your favourites and matchbook stay on your device. Refreshing connects directly to the fixture source or your RSS publisher and shares your IP address with them. No account is required."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your favorites and matchbook stay on your device. Refreshing connects directly to the fixture source or your RSS publisher and shares your IP address with them. No account is required."
          }
        }
      }
    },
