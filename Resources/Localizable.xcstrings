          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dois adversários cercam o ala, devolva ao zagueiro por fora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird der Wingback gedoppelt, zurück zum äußeren Innenverteidiger spielen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le piston est pris à deux, revenez au central excentré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si dos rivales cierran al carrilero, recicla con el central exterior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se l’esterno viene raddoppiato, torna al centrale di parte."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When the wing-back meets a double team, recycle the ball to the outside centre-back."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "When the wing-back meets a double team, recycle the ball to the outside center-back."
          }
        }
      }
    },
