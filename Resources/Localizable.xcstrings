    "The outside midfielder stays wide. Pass beyond the pressing forward while the inside passing lane remains protected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The outside midfielder stays wide. Pass beyond the pressing forward while the inside passing lane remains protected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى لاعب الوسط الطرفي بعيدًا على الخط. مرر خلف المهاجم الضاغط مع الحفاظ على تغطية الممر الداخلي."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊中場保持寬度。兼顧內線保護，把球送過上前逼搶的前鋒。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O meia aberto sustenta a largura. Supere o primeiro atacante mantendo a linha interna protegida."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der äußere Mittelfeldspieler bleibt breit. Den Stürmer überspielen, während die Mitte gesichert bleibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le milieu reste large. Dépassez le premier attaquant tout en protégeant la ligne intérieure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volante mantiene la amplitud. Supera al punta que presiona y protege la línea interior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esterno resta largo. Supera la punta in pressione mantenendo protetta la linea interna."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The outside midfielder stays wide. Pass beyond the pressing forward while the inside passing lane remains protected."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The outside midfielder stays wide. Pass beyond the pressing forward while the inside passing lane remains protected."
          }
        }
      }
    },
    "The attacking midfielder checks into the space behind the press, ready to receive on the turn.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attacking midfielder checks into the space behind the press, ready to receive on the turn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحرك صانع اللعب إلى المساحة خلف الضغط ليستقبل الكرة ويدور بها."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "攻擊中場移入逼搶線後的空位，準備接球轉身。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O meia procura espaço atrás da pressão para receber e girar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zehner löst sich hinter die Pressinglinie und kann in der Drehung annehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le milieu offensif se démarque derrière le pressing pour se retourner à la réception."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mediapunta se ofrece detrás de la presión para recibir y girar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trequartista si smarca dietro la pressione per ricevere e girarsi."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The attacking midfielder checks into the space behind the press, ready to receive on the turn."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The attacking midfielder checks into the space behind the press, ready to receive on the turn."
          }
        }
      }
