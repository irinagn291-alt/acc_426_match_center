    "The full-back draws pressure towards the near touchline. The holding midfielder opens a passing lane behind the first presser.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full-back draws pressure towards the near touchline. The holding midfielder opens a passing lane behind the first presser."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجذب الظهير الضغط نحو خط التماس القريب. يفتح لاعب الارتكاز مسارًا للتمريرة خلف المدافع الأول."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊後衛將逼搶引向近側邊線。防守中場移到第一名逼搶球員身後，接應傳球。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lateral atrai a pressão para a linha. O volante oferece passe atrás de quem pressiona."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Außenverteidiger zieht den Druck zur Linie. Der Sechser bietet sich hinter dem ersten Gegner an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le latéral attire la pression vers la touche. La sentinelle offre une passe derrière le premier adversaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lateral atrae la presión hacia la banda. El pivote ofrece un pase detrás del primer rival."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terzino attira la pressione sulla linea. Il mediano si offre dietro il primo avversario."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The full-back draws pressure towards the near touchline. The holding midfielder opens a passing lane behind the first presser."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The full-back draws pressure toward the near touchline. The holding midfielder opens a passing lane behind the first presser."
          }
        }
      }
    },
    "The pivot receives side-on and moves the ball across the midfield before the block can slide.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pivot receives side-on and moves the ball across the midfield before the block can slide."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستقبل لاعب الارتكاز الكرة بجسم نصف مفتوح ثم ينقلها عرضيًا قبل أن يتحرك التكتل الدفاعي."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樞紐球員側身接球，在防守陣形橫移之前將球轉往另一側。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O volante recebe de lado e vira antes de o bloco acompanhar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sechser nimmt seitlich an und verlagert, bevor der Block verschiebt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pivot reçoit de profil et renverse avant que le bloc puisse coulisser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pivote recibe de perfil y cambia el juego antes de que bascule el bloque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mediano riceve di fianco e cambia gioco prima che il blocco scivoli."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The pivot receives side-on and moves the ball across the midfield before the block can slide."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The pivot receives side-on and moves the ball across the midfield before the block can slide."
          }
        }
      }
    },
    "The far-side full-back finds the winger wide. Drive forward while the opposing full-back is still recovering.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The far-side full-back finds the winger wide. Drive forward while the opposing full-back is still recovering."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمرر الظهير البعيد إلى الجناح المتمركز على الطرف. تقدم قبل أن يعود ظهير الخصم إلى موقعه."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠側邊後衛找到貼邊的翼鋒。趁對方邊後衛尚未回防時向前推進。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lateral oposto aciona o ponta aberto. Avance antes da recomposição."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ballferne Außenverteidiger findet den Flügel. Vorrücken, bevor der Gegner zurück ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le latéral opposé trouve l’ailier écarté. Avancez avant le repli adverse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lateral opuesto encuentra al extremo abierto. Avanza antes del repliegue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terzino opposto trova l’ala larga. Avanza prima del rientro avversario."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The far-side full-back finds the winger wide. Drive forward while the opposing full-back is still recovering."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The far-side full-back finds the winger wide. Drive forward while the opposing full-back is still recovering."
          }
        }
      }
    },
    "A deeper midfielder plays into the attacking midfielder between the lines.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deeper midfielder plays into the attacking midfielder between the lines."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمرر لاعب الوسط المتأخر إلى صانع اللعب بين الخطوط."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後方中場把球傳給在兩線之間接應的攻擊中場。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O meio-campista de trás encontra o meia entre as linhas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der tiefere Mittelfeldspieler findet den Zehner zwischen den Linien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un milieu en retrait trouve le meneur entre les lignes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un centrocampista retrasado encuentra al mediapunta entre líneas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il centrocampista arretrato serve il trequartista tra le linee."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A deeper midfielder plays into the attacking midfielder between the lines."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A deeper midfielder plays into the attacking midfielder between the lines."
          }
        }
      }
    },
    "The receiver sets the ball back first time. A teammate arriving from the blind side can now face forward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The receiver sets the ball back first time. A teammate arriving from the blind side can now face forward."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد المستلم الكرة من لمسة واحدة. يستقبلها زميل قادم من خارج مجال رؤية المدافع وهو مواجه للمرمى."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接球者第一時間回做。從防守者視線外插上的隊友便能面向前方接球。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O receptor devolve de primeira. Quem chega pelo ponto cego recebe de frente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prallen lassen. Ein Mitspieler läuft im Rücken des Gegners an und kann nach vorn spielen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remise en une touche. Un partenaire arrive hors du champ visuel et reçoit face au jeu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El receptor devuelve de primera. Un compañero llega desde el lado ciego y recibe de cara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sponda di prima. Il compagno arriva fuori dal campo visivo e riceve fronte alla porta."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The receiver sets the ball back first time. A teammate arriving from the blind side can now face forward."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The receiver sets the ball back first time. A teammate arriving from the blind side can now face forward."
          }
        }
      }
    },
    "The runner releases the striker into the channel before the centre-backs can step across.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The runner releases the striker into the channel before the centre-backs can step across."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل اللاعب المنطلق الكرة إلى المهاجم في الممر قبل أن يغلقه قلبا الدفاع."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "插上的球員傳出直線球，讓前鋒在兩名中堅封堵前攻入通道。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem chega lança o atacante no corredor antes da cobertura dos zagueiros."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Läufer schickt den Stürmer in den Kanal, bevor die Innenverteidiger schließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joueur lancé sert l’avant-centre dans le couloir avant la couverture des centraux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El corredor lanza al delantero al pasillo antes de que cierren los centrales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi si inserisce lancia la punta nel canale prima della chiusura dei centrali."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The runner releases the striker into the channel before the centre-backs can step across."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The runner releases the striker into the channel before the center-backs can step across."
          }
        }
      }
    },
    "The full-back passes ahead to the wide midfielder and continues up the touchline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full-back passes ahead to the wide midfielder and continues up the touchline."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمرر الظهير إلى لاعب الوسط الطرفي ثم يواصل الجري على خط التماس."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊後衛向前傳給邊中場，隨即沿邊線繼續跑動。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lateral toca no meia aberto e continua pela linha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Außenverteidiger passt zum äußeren Mittelfeldspieler und läuft außen weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le latéral sert le milieu excentré et poursuit sa course le long de la touche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lateral juega con el volante y continúa por la banda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terzino serve l’esterno e continua lungo la linea."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The full-back passes ahead to the wide midfielder and continues up the touchline."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The full-back passes ahead to the wide midfielder and continues up the touchline."
          }
        }
      }
    },
    "The wide midfielder waits for the defender to turn inward, then releases the overlapping full-back into space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wide midfielder waits for the defender to turn inward, then releases the overlapping full-back into space."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتظر لاعب الطرف حتى يلتفت المدافع للداخل، ثم يمرر إلى الظهير المنطلق خلفه في المساحة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊中場等待防守者轉向內線，再把球交給套上空位的邊後衛。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O meia espera o marcador fechar por dentro e serve o lateral que ultrapassa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Flügelspieler wartet, bis der Gegner nach innen dreht, und spielt außen in den Lauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ailier attend que le défenseur se tourne vers l’intérieur puis lance le latéral."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volante espera a que el defensor gire hacia dentro y lanza al lateral que dobla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esterno aspetta che il difensore giri dentro e lancia il terzino in sovrapposizione."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The wide midfielder waits for the defender to turn inward, then releases the overlapping full-back into space."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The wide midfielder waits for the defender to turn inward, then releases the overlapping full-back into space."
          }
        }
      }
    },
    "Look back towards the penalty spot for a cutback. The second striker holds a different finishing lane.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look back towards the penalty spot for a cutback. The second striker holds a different finishing lane."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن تمريرة عكسية نحو نقطة الجزاء. يشغل المهاجم الثاني ممرًا مختلفًا للتسديد."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回望十二碼點方向，尋找倒三角傳球。另一名前鋒佔據不同的射門路線。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procure o passe para trás na marca do pênalti. O outro atacante ocupa outra faixa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückpass zum Elfmeterpunkt suchen. Der zweite Stürmer besetzt eine andere Abschlusszone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez le centre en retrait vers le point de penalty. Le second attaquant occupe une autre zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca el pase atrás al punto de penalti. El segundo punta ocupa otro carril de remate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca il traversone arretrato sul dischetto. La seconda punta occupa un’altra zona di tiro."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Look back towards the penalty spot for a cutback. The second striker holds a different finishing lane."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Look back toward the penalty spot for a cutback. The second striker holds a different finishing lane."
          }
        }
      }
    },
    "The goalkeeper attracts the first forward before finding the free centre-back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The goalkeeper attracts the first forward before finding the free centre-back."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجذب الحارس المهاجم الأول ثم يمرر إلى قلب الدفاع الحر."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "門將先吸引第一名前鋒，再傳給無人盯防的中堅。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O goleiro atrai o primeiro atacante e encontra o zagueiro livre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Torwart zieht den ersten Stürmer an und findet den freien Innenverteidiger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gardien attire le premier attaquant puis trouve le défenseur central libre."
          }
        },
        "es": {
          "stringUnit": {
