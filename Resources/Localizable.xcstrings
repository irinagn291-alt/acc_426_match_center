    "Favourite the team first. Available within 8 hours of scheduled kickoff; no score updates through Live Activity.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourite the team first. Available within 8 hours of scheduled kickoff; no score updates through Live Activity."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite o time primeiro. Disponível nas 8 horas antes do início previsto; sem placares pela Atividade ao Vivo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere zuerst ein Team als Favorit. Verfügbar in den 8 Stunden vor Anstoß; keine Spielstandsaktualisierung per Live-Aktivität."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d'abord l'équipe aux favoris. Disponible dans les 8 heures avant le coup d'envoi prévu ; aucun score via l'Activité en direct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca primero el equipo como favorito. Disponible durante las 8 horas antes del inicio previsto; sin resultados en la Actividad en directo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima la squadra ai preferiti. Disponibile nelle 8 ore prima dell'inizio previsto; nessun risultato tramite Attività live."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الفريق إلى المفضلة أولًا. يتاح العد التنازلي خلال الساعات الثماني السابقة للبداية، ويعرض موعد المباراة فقط."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先收藏球隊。開賽前八小時內可啟動即時動態，顯示開賽倒數。"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourite the team first. Available within 8 hours of scheduled kickoff; no score updates through Live Activity."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite the team first. Available within 8 hours of scheduled kickoff; no score updates through Live Activity."
          }
        }
      }
    },
