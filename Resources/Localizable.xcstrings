    },
    "A diagonal pass across the last defender finds the striker. Support underneath if the forward pass closes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagonal pass across the last defender finds the striker. Support underneath if the forward pass closes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل تمريرة قطرية أمام آخر مدافع إلى المهاجم. اقترب خلف حامل الكرة إذا أُغلق المسار الأمامي."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "斜傳越過最後一名防守者找到前鋒。若向前路線被封鎖，移到持球者身後接應。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagonal supera o último defensor e acha o atacante. Dê apoio atrás se o passe fechar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Diagonalpass erreicht den Stürmer hinter dem letzten Gegner. Bei geschlossenem Weg hinten anbieten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une diagonale trouve l’attaquant au-delà du dernier défenseur. Soutenez derrière si la passe se ferme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una diagonal supera al último defensor y encuentra al punta. Ofrece apoyo atrás si se cierra el pase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una diagonale supera l’ultimo difensore e trova la punta. Offri sostegno dietro se si chiude il passaggio."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagonal pass across the last defender finds the striker. Support underneath if the forward pass closes."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A diagonal pass across the last defender finds the striker. Support underneath if the forward pass closes."
          }
        }
      }
    },
    "When the wing-back meets a double team, recycle the ball to the outside centre-back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the wing-back meets a double team, recycle the ball to the outside centre-back."
          }
