    "The central runner feeds the wide player early, stretching the retreating defence.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The central runner feeds the wide player early, stretching the retreating defence."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبكر اللاعب المنطلق في الوسط بالتمرير إلى الطرف ليجبر الدفاع المتراجع على التمدد."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中路插上的球員及早分邊，拉開正在後撤的防線。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O corredor central serve cedo o ponta para abrir a defesa em recuo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zentrale Läufer spielt früh nach außen und zieht die zurückweichende Abwehr auseinander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le porteur axial sert vite le joueur de côté et étire la défense en repli."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El corredor central abre pronto a banda y estira la defensa en repliegue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi corre al centro apre presto sull’esterno e allarga la difesa in ripiegamento."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The central runner feeds the wide player early, stretching the retreating defence."
