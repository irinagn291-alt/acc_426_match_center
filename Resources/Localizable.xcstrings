            "value": "Il portiere attira il primo attaccante e trova il centrale libero."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The goalkeeper attracts the first forward before finding the free centre-back."
          }
        },
