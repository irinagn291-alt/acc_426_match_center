    "The holding midfielder secures the loose ball and looks forward before taking a second touch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The holding midfielder secures the loose ball and looks forward before taking a second touch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسيطر لاعب الارتكاز على الكرة المرتدة ويرفع رأسه قبل اللمسة الثانية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防守中場收下第二落點的球，在第二次觸球前先察看前方。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O volante domina a sobra e olha à frente antes do segundo toque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sechser sichert den freien Ball und blickt vor dem zweiten Kontakt nach vorn."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sentinelle gagne le ballon libre et regarde devant avant son deuxième contact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pivote asegura el balón suelto y mira hacia delante antes del segundo toque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il mediano conquista la palla vagante e guarda avanti prima del secondo tocco."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The holding midfielder secures the loose ball and looks forward before taking a second touch."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The holding midfielder secures the loose ball and looks forward before taking a second touch."
          }
        }
