    "Start reminders follow saved kickoff times. Score and start changes are announced only after data refresh. iOS chooses background timing; instant alerts are not available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start reminders follow saved kickoff times. Score and start changes are announced only after data refresh. iOS chooses background timing; instant alerts are not available."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes seguem os horários salvos. Mudanças no placar e no início são avisadas só após atualizar os dados. O iOS define a atualização em segundo plano; não há alertas instantâneos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen folgen gespeicherten Anstoßzeiten. Spielstands- und Startänderungen werden erst nach Datenaktualisierung gemeldet. iOS bestimmt Hintergrundzeiten; sofortige Meldungen sind nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels suivent les horaires enregistrés. Les changements de score et de début sont annoncés après actualisation. iOS décide du moment en arrière-plan ; les alertes instantanées ne sont pas disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios siguen los horarios guardados. Los cambios de resultado e inicio se avisan tras actualizar datos. iOS decide los tiempos en segundo plano; no hay alertas instantáneas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria seguono gli orari salvati. Le variazioni di risultato e inizio sono annunciate dopo l'aggiornamento. iOS decide i tempi in background; non sono disponibili avvisi istantanei."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع تذكيرات البداية المواعيد المحفوظة. تُرسل تغييرات النتيجة والموعد بعد التحديث. يحدد iOS مواعيد التحديث في الخلفية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依照已儲存的開賽時間提醒。更新資料後才會通知比分和時間異動。背景更新時間由 iOS 決定。"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Start reminders follow saved kickoff times. Score and start changes are announced only after data refresh. iOS chooses background timing; instant alerts are not available."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Start reminders follow saved kickoff times. Score and start changes are announced only after data refresh. iOS chooses background timing; instant alerts are not available."
          }
        }
      }
    },
