    "Add a feed you are permitted to read for personal use. Only headlines and links are cached; article text and images are not downloaded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a feed you are permitted to read for personal use. Only headlines and links are cached; article text and images are not downloaded."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um feed que você tenha permissão de ler para uso pessoal. Apenas títulos e links são salvos; textos e imagens não são baixados."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Feed hinzu, den du privat lesen darfst. Nur Überschriften und Links werden gespeichert; Artikeltexte und Bilder werden nicht geladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un flux autorisé pour votre usage personnel. Seuls les titres et liens sont conservés ; les textes et images ne sont pas téléchargés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una fuente que tengas permiso de leer para uso personal. Solo se guardan títulos y enlaces; no se descargan textos ni imágenes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un feed che puoi leggere per uso personale. Si salvano solo titoli e link; testi e immagini non vengono scaricati."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف موجزًا مسموحًا لك بقراءته. تُحفظ العناوين والروابط فقط دون نص المقال أو صوره."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請加入可供個人閱讀的來源。只會快取標題和連結，不會下載全文或圖片。"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a feed you are permitted to read for personal use. Only headlines and links are cached; article text and images are not downloaded."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a feed you are permitted to read for personal use. Only headlines and links are cached; article text and images are not downloaded."
          }
        }
      }
    },
